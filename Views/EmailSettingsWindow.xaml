<Window x:Class="LeadManager.Views.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LeadManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EmailSettingsViewModel}"
        Title="Email settings" Width="640" Height="720" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" MinWidth="90" IsCancel="True" Margin="0,0,8,0" />
                        <Button Content="Save" MinWidth="90" Style="{StaticResource PrimaryButton}" IsDefault="True" Command="{Binding SaveCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test connection" Command="{Binding TestCommand}" Margin="0,0,8,0"
                                ToolTip="Sign in to your mail server without sending anything" />
                        <Button Content="Send test email" Command="{Binding SendTestEmailCommand}"
                                ToolTip="Send a short test email to your own address" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24">
                <TextBlock Text="Email settings" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="The account Lead Manager sends from. Your password is stored encrypted, readable only by your Windows account on this PC." />
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                        Visibility="{Binding IsFirstTime, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AccentPressedBrush}"
                               Text="Set this up once and you can email leads straight from Lead Manager." />
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Email provider" Style="{StaticResource CardTitle}" />
                        <ComboBox Style="{StaticResource SelectComboBox}" Margin="0,10,0,0" ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
                        <TextBlock Text="{Binding PresetHelp}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Your name" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Text="{Binding FromName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Shown to recipients as the sender" />
                            <TextBlock Grid.Column="2" Text="Your email address" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ToolTip="Usually your full email address" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Password" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="PasswordInput" Grid.Row="3" Grid.Column="2" PasswordChanged="PasswordInput_PasswordChanged" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PasswordHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"
                                       Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <Expander Header="Server details" Margin="0,16,0,0" IsExpanded="{Binding ShowServerDetails, Mode=OneTime}">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="Sending (SMTP)" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2" Text="Port" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="4" Text="Security" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="4" Style="{StaticResource SelectComboBox}" ItemsSource="{Binding SecurityOptions}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SmtpSecurity}" />
                                </Grid>

                                <CheckBox Content="Save a copy of each email to my Sent folder (IMAP)" IsChecked="{Binding SaveToSentFolder}" Margin="0,16,0,0"
                                          ToolTip="Many mail servers don't file emails sent from other apps; this puts a copy in your Sent folder" />
                                <StackPanel Visibility="{Binding SaveToSentFolder, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="IMAP server" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Text="{Binding ImapHost, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Text="Port" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="4" Text="Security" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="4" Style="{StaticResource SelectComboBox}" ItemsSource="{Binding SecurityOptions}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding ImapSecurity}" />
                                    </Grid>
                                    <TextBlock Text="Sent folder name (leave blank to find it automatically)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SentFolder, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Sending" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Pause between emails" VerticalAlignment="Center" />
                            <TextBox Width="56" Margin="10,0,8,0" HorizontalContentAlignment="Center" Text="{Binding PauseSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Spacing emails out keeps a burst of messages from looking like spam to mail providers." />

                        <TextBlock Text="Footer added to every email" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                        <TextBox Text="{Binding Footer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" MinHeight="64" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="For cold email, US rules (CAN-SPAM) expect a postal address and a way to opt out, e.g. “Not interested? Reply and I won't email again.”" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
