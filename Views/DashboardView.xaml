<UserControl x:Class="LeadManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeadManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">

            <!-- First run: nothing imported yet -->
            <Border Style="{StaticResource Card}" MaxWidth="580" Padding="32,28" Margin="0,48,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Visibility="{Binding HasLeads, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="Welcome to Lead Manager" Style="{StaticResource PageTitle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" LineHeight="20"
                               Text="Import a CSV of leads to get started. Columns like Name, Email and Practice are matched automatically, and you can re-import an updated list any time without losing your notes." />
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.ImportCsvCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,8,0" />
                                <TextBlock Text="Import CSV…" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Content="Add a lead by hand"
                                Command="{Binding DataContext.NewLeadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                    <TextBlock Text="Tip: you can also drag a CSV file onto this window." Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasLeads, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding TodayText}" Style="{StaticResource Muted}" Margin="0,2,0,16" />

                <!-- Headline numbers; each tile opens the matching slice of the Leads page -->
                <UniformGrid Columns="5" Margin="0,0,-12,16">
                    <Button Style="{StaticResource StatTile}" Command="{Binding ShowLeadsCommand}" CommandParameter="All" ToolTip="Show all leads">
                        <StackPanel>
                            <TextBlock Text="All leads" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="In your list" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatTile}" Command="{Binding ShowLeadsCommand}" CommandParameter="NotContacted" ToolTip="Show leads you haven't contacted yet">
                        <StackPanel>
                            <TextBlock Text="Not contacted" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding NotContactedCount}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Ready for outreach" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatTile}" Command="{Binding ShowLeadsCommand}" CommandParameter="Contacted" ToolTip="Show leads you've contacted">
                        <StackPanel>
                            <TextBlock Text="Contacted" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ContactedCount}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ContactedCaption}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatTile}" Command="{Binding ShowLeadsCommand}" CommandParameter="Engaged"
                            ToolTip="Show leads that replied, booked a meeting, started a pilot or became customers">
                        <StackPanel>
                            <TextBlock Text="Engaged" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding EngagedCount}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EngagedCaption}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowLeadsCommand}" CommandParameter="FollowUpDue" ToolTip="Show leads due for a follow-up">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatTile}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFollowUps}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DueSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="11" Foreground="{StaticResource DueBrush}" Margin="0,0,5,0"
                                           Visibility="{Binding HasFollowUps, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Follow-ups due" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="{Binding FollowUpsDueCount}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Today or overdue" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- Follow-ups due -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="26" Padding="8,2"
                                            Content="{Binding MoreFollowUpsText}" Command="{Binding ShowLeadsCommand}" CommandParameter="FollowUpDue"
                                            Visibility="{Binding MoreFollowUpsText, Converter={StaticResource NullToVisibility}}" />
                                    <StackPanel>
                                        <TextBlock Text="Follow-ups due" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Oldest first. Open one and use Next to work through them." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Nothing due. You're all caught up." Style="{StaticResource Muted}" Margin="0,14,0,4"
                                           Visibility="{Binding HasFollowUps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ItemsControl ItemsSource="{Binding FollowUps}" Margin="-8,8,-8,-6" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ListRowButton}" CommandParameter="{Binding}" ToolTip="Open this lead"
                                                    Command="{Binding DataContext.ViewFollowUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SecondaryName}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource DueBadge}" Margin="12,0">
                                                        <TextBlock Text="{Binding FollowUpOn, Converter={StaticResource FriendlyDate}, ConverterParameter=Due}" FontSize="12" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="View ›" Foreground="{StaticResource AccentPressedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Up next -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="26" Padding="8,2"
                                            Content="{Binding MoreUpNextText}" Command="{Binding ShowLeadsCommand}" CommandParameter="NotContacted"
                                            Visibility="{Binding MoreUpNextText, Converter={StaticResource NullToVisibility}}" />
                                    <StackPanel>
                                        <TextBlock Text="Up next" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Not contacted yet, highest priority first." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="Everyone has been contacted. Nice work." Style="{StaticResource Muted}" Margin="0,14,0,4"
                                           Visibility="{Binding HasUpNext, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ItemsControl ItemsSource="{Binding UpNext}" Margin="-8,8,-8,-6" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ListRowButton}" CommandParameter="{Binding}" ToolTip="Open this lead"
                                                    Command="{Binding DataContext.ViewUpNextCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SecondaryName}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                                                        <Ellipse Style="{StaticResource PriorityDot}" />
                                                        <TextBlock Text="{Binding FitPriority}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="View ›" Foreground="{StaticResource AccentPressedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Pipeline: one hue, counts labelled directly -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Pipeline" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Leads by status. Click a row to see them." Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding Pipeline}" Margin="-8,0,-8,-6" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ListRowButton}" Padding="8,5" ToolTip="{Binding Tooltip}" CommandParameter="{Binding Status}"
                                                Command="{Binding DataContext.ShowStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Style="{StaticResource MeterBar}" Minimum="0" Maximum="{Binding Largest, Mode=OneWay}" Value="{Binding Count, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
