<UserControl x:Class="LeadManager.Views.LeadListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LeadManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="560"
             d:DataContext="{d:DesignInstance Type=vm:LeadListViewModel}">
    <UserControl.Resources>
        <!-- Right-click menu for a row; its DataContext is that row's lead -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="View" FontWeight="SemiBold" InputGestureText="Enter" CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.ViewLeadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Message…" CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.MessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy email" CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.CopyEmailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open website" CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Mark contacted today" CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.MarkContactedTodayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete…" InputGestureText="Del" CommandParameter="{Binding}"
                      Command="{Binding PlacementTarget.Tag.DeleteLeadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel Margin="24,16,24,20">
        <!-- Quick filters -->
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ShownSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <WrapPanel>
                <RadioButton Style="{StaticResource Chip}" GroupName="QuickFilter"
                             IsChecked="{Binding QuickFilter, Converter={StaticResource Equals}, ConverterParameter=All}">
                    <TextBlock><Run Text="All" /><Run Text="{Binding AllCount, Mode=OneWay, StringFormat='  {0}'}" FontWeight="SemiBold" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="QuickFilter"
                             IsChecked="{Binding QuickFilter, Converter={StaticResource Equals}, ConverterParameter=NotContacted}">
                    <TextBlock><Run Text="Not contacted" /><Run Text="{Binding NotContactedCount, Mode=OneWay, StringFormat='  {0}'}" FontWeight="SemiBold" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="QuickFilter"
                             IsChecked="{Binding QuickFilter, Converter={StaticResource Equals}, ConverterParameter=Contacted}">
                    <TextBlock><Run Text="Contacted" /><Run Text="{Binding ContactedCount, Mode=OneWay, StringFormat='  {0}'}" FontWeight="SemiBold" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="QuickFilter" ToolTip="Replied, meeting booked, pilot or customer"
                             IsChecked="{Binding QuickFilter, Converter={StaticResource Equals}, ConverterParameter=Engaged}">
                    <TextBlock><Run Text="Engaged" /><Run Text="{Binding EngagedCount, Mode=OneWay, StringFormat='  {0}'}" FontWeight="SemiBold" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource Chip}" GroupName="QuickFilter" ToolTip="Follow-up date is today or earlier"
                             IsChecked="{Binding QuickFilter, Converter={StaticResource Equals}, ConverterParameter=FollowUpDue}">
                    <TextBlock><Run Text="Follow-up due" /><Run Text="{Binding FollowUpDueCount, Mode=OneWay, StringFormat='  {0}'}" FontWeight="SemiBold" /></TextBlock>
                </RadioButton>
            </WrapPanel>
        </DockPanel>

        <!-- Search and filters -->
        <Grid DockPanel.Dock="Top" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Padding="32,6,30,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock Text="Search name, practice, email, location or notes   (Ctrl+F)" Foreground="{StaticResource PlaceholderBrush}"
                           Margin="33,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource IconGhostButton}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,4,0"
                        Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                        Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToVisibility}}" />
            </Grid>
            <ComboBox Grid.Column="1" Width="160" Margin="8,0,0,0" Style="{StaticResource SelectComboBox}" MaxDropDownHeight="400"
                      ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter}" ToolTip="Filter by status" />
            <ComboBox Grid.Column="2" Width="136" Margin="8,0,0,0" Style="{StaticResource SelectComboBox}"
                      ItemsSource="{Binding PriorityFilterOptions}" SelectedItem="{Binding PriorityFilter}" ToolTip="Filter by fit priority" />
            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Clear filters" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Actions for the ticked rows -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}" BorderBrush="#BFD6F3" BorderThickness="1" CornerRadius="8"
                Padding="12,6" Margin="0,0,0,10" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear selection" Click="ClearSelection_Click" ToolTip="Esc" />
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" Foreground="{StaticResource AccentPressedBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding MessageCommand}" Margin="0,0,6,0" MinHeight="30" Padding="12,3"
                            ToolTip="Write one email; each selected lead gets their own personalised copy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" Margin="0,0,8,0" />
                            <TextBlock Text="Message…" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MarkContactedTodayCommand}" Margin="0,0,6,0" MinHeight="30" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,6,0" />
                            <TextBlock Text="Contacted today" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StatusMenuButton" Margin="0,0,6,0" MinHeight="30" Padding="10,3" Click="StatusMenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Set status" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="6,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding Statuses}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="Command" Value="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="FollowUpMenuButton" Margin="0,0,6,0" MinHeight="30" Padding="10,3" Click="FollowUpMenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Follow up" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="6,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="In 3 days" Command="{Binding SetFollowUpCommand}" CommandParameter="3" />
                                <MenuItem Header="In 1 week" Command="{Binding SetFollowUpCommand}" CommandParameter="7" />
                                <MenuItem Header="In 2 weeks" Command="{Binding SetFollowUpCommand}" CommandParameter="14" />
                                <Separator />
                                <MenuItem Header="Clear follow-up" Command="{Binding SetFollowUpCommand}" CommandParameter="0" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource DangerGhostButton}" Command="{Binding DeleteLeadCommand}" MinHeight="30" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,6,0" />
                            <TextBlock Text="Delete…" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- The grid -->
        <Border Style="{StaticResource Card}" Padding="1">
            <Grid>
                <DataGrid x:Name="LeadsGrid" Style="{StaticResource LeadGrid}" ItemsSource="{Binding LeadsView}" SelectedItem="{Binding SelectedLead}"
                          SelectionMode="Extended" IsSynchronizedWithCurrentItem="False" HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="LeadsGrid_MouseDoubleClick" PreviewKeyDown="LeadsGrid_PreviewKeyDown" SelectionChanged="LeadsGrid_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFollowUpDue}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DueSoftBrush}" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="SelectAllBox" Click="SelectAllBox_Click" Focusable="False" ToolTip="Select all shown leads (Ctrl+A)" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Focusable="False" VerticalAlignment="Center" PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"
                                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding LeadCode}" Width="66" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Lead" SortMemberPath="ContactName" Width="2*" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SecondaryName}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SecondaryName, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="60" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Priority" SortMemberPath="PriorityRank" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource PriorityDot}" />
                                        <TextBlock Text="{Binding FitPriority}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="122">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last contact" Binding="{Binding ContactedOn, Converter={StaticResource FriendlyDate}}"
                                            SortMemberPath="ContactedOn" Width="94" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Follow up" SortMemberPath="FollowUpOn" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C1;" FontSize="11" Foreground="{StaticResource DueBrush}" Margin="0,0,5,0"
                                                   ToolTip="Follow-up due" Visibility="{Binding IsFollowUpDue, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding FollowUpOn, Converter={StaticResource FriendlyDate}, ConverterParameter=DueShort}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFollowUpDue}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DueBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="88" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SmallButton}" CommandParameter="{Binding}" ToolTip="Open this lead (or double-click the row)"
                                            HorizontalAlignment="Left" Padding="10,2,12,2"
                                            Command="{Binding DataContext.ViewLeadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="0,0,5,0" />
                                            <TextBlock Text="View" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty: nothing imported yet -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,0" MaxWidth="420"
                            Visibility="{Binding HasLeads, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="32" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No leads yet" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="Import a CSV or add a lead by hand to get started. You can also drag a CSV onto this window."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="Import CSV…"
                                Command="{Binding DataContext.ImportCsvCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="New lead" Margin="8,0,0,0"
                                Command="{Binding DataContext.NewLeadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Empty: filters hide everything -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,0"
                            Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No leads match these filters" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,12" />
                    <Button Content="Clear filters" HorizontalAlignment="Center" Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
