<Window x:Class="LeadManager.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LeadManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ComposeViewModel}"
        Title="{Binding Title}" Width="1040" Height="700" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2,9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#EFEEEA" />
            <Setter Property="TextElement.Foreground" Value="#52514E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Sending…">
                    <Setter Property="Background" Value="#E3EEFB" />
                    <Setter Property="TextElement.Foreground" Value="#1C5CAB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Sent">
                    <Setter Property="Background" Value="#DDF0DD" />
                    <Setter Property="TextElement.Foreground" Value="#006300" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Background" Value="#FBE5E5" />
                    <Setter Property="TextElement.Foreground" Value="#A12B2B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Who it's going to -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="24,16,24,14">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="To" Style="{StaticResource Muted}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ToSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AllRecipientsText}" />
                </DockPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Border Style="{StaticResource DueBadge}" Margin="0,0,12,0" ToolTip="{Binding SkippedDetails}"
                            Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock FontSize="12"><Run Text="{Binding SkippedSummary, Mode=OneWay}" /><Run Text="  (hover to see why)" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="{Binding AlreadySentText}" IsChecked="{Binding SkipAlreadySent}" IsEnabled="{Binding IsWriting}"
                              ToolTip="These leads already got this template (or this subject line) from Lead Manager"
                              Visibility="{Binding HasAlreadySent, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Footer: options and Send while writing; progress while sending -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <DockPanel Visibility="{Binding IsWriting, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButton}" MinWidth="130" Command="{Binding SendCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding SendButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel>
                            <CheckBox Content="Mark as contacted and add a note" IsChecked="{Binding MarkContacted}" Margin="0,0,18,0" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding SetFollowUp}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Follow up in" VerticalAlignment="Center" />
                                    <TextBox Width="38" MinHeight="24" Padding="4,1" Margin="6,0" HorizontalContentAlignment="Center"
                                             Text="{Binding FollowUpDays, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="days" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0">
                            <Run Text="From" /> <Run Text="{Binding FromText, Mode=OneWay}" /><Run Text="   ·   " /><Hyperlink Command="{Binding ChangeSettingsCommand}">Email settings</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <DockPanel Visibility="{Binding IsWriting, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Stop sending" MinWidth="110" Command="{Binding StopCommand}"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Close" MinWidth="96" Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}"
                                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource MeterBar}" Height="8" Margin="0,8,0,0"
                                     Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Test environment: say plainly where these emails go -->
        <Border DockPanel.Dock="Top" Background="#FFE8B0" BorderBrush="#E9C46A" BorderThickness="0,0,0,1" Padding="24,8"
                Visibility="{Binding TestNotice, Converter={StaticResource NullToVisibility}}">
            <TextBlock Foreground="#6B4700" TextWrapping="Wrap">
                <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" /><Run Text="  " /><Run Text="{Binding TestNotice, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <!-- Why sending stopped -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerSoftBrush}" Padding="24,10"
                Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Problem}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Margin="24,16,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- The message -->
            <Border Style="{StaticResource Card}" Padding="18,14" IsEnabled="{Binding IsWriting}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Template" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Grid Grid.Column="1">
                            <ComboBox x:Name="TemplatePicker" Style="{StaticResource SelectComboBox}" ItemsSource="{Binding Templates}"
                                      SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" />
                            <TextBlock Text="Start from a template…" Foreground="{StaticResource PlaceholderBrush}" Margin="11,0,30,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SelectedTemplate, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                        </Grid>
                        <Button Grid.Column="2" Content="Save" Margin="8,0,0,0" Command="{Binding SaveTemplateCommand}"
                                ToolTip="Save your changes to this template" />
                        <Button x:Name="TemplateMenuButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="8,0,0,0"
                                ToolTip="More template options" Click="TemplateMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Save as a new template…" Command="{Binding SaveTemplateAsCommand}" />
                                    <MenuItem Header="Import a template from Outlook (.msg)…" Command="{Binding ImportTemplateCommand}" />
                                    <Separator />
                                    <MenuItem Header="Delete this template…" Command="{Binding DeleteTemplateCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="Subject" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SubjectBox" DockPanel.Dock="Top" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Field_GotKeyboardFocus" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="Insert" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Top" Margin="0,5,8,0" />
                            <ItemsControl ItemsSource="{Binding Placeholders}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SmallButton}" Content="{Binding Label}" Tag="{Binding Token}" Margin="0,0,6,6"
                                                Focusable="False" Click="InsertPlaceholder_Click"
                                                ToolTip="{Binding Token, StringFormat='Inserts {{{{{0}}}}}, filled in for each lead'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                   Text="Links: paste a web address, or write [link text](https://…) to link words." />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Message" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BodyBox" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8,8" GotKeyboardFocus="Field_GotKeyboardFocus" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Preview while writing -->
                    <DockPanel Margin="18,14" Visibility="{Binding IsWriting, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="11" Command="{Binding PreviousPreviewCommand}" ToolTip="Previous lead" />
                                <TextBlock Text="{Binding PreviewPosition}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="11" Command="{Binding NextPreviewCommand}" ToolTip="Next lead" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Preview" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Exactly what each lead receives." Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                        <ComboBox DockPanel.Dock="Top" Style="{StaticResource SelectComboBox}" Margin="0,10,0,0" MaxDropDownHeight="360"
                                  ItemsSource="{Binding Recipients}" SelectedItem="{Binding PreviewRecipient}" DisplayMemberPath="Display" />
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,10">
                            <StackPanel>
                                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="To  " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding PreviewTo, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding PreviewSubject}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding PreviewNotes}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="12" Foreground="{StaticResource DueBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource DueBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding PreviewBody}" TextWrapping="Wrap" LineHeight="19" />
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Per-lead progress while sending and after -->
                    <DockPanel Margin="18,14" Visibility="{Binding IsWriting, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock DockPanel.Dock="Top" Text="Recipients" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Recipients}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding State}" FontSize="12" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Lead.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Lead.Email}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
