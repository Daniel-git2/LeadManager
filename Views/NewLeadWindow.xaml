<Window x:Class="LeadManager.Views.NewLeadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:LeadManager.Models"
        xmlns:vm="clr-namespace:LeadManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NewLeadViewModel}"
        Title="New lead" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Add lead" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,18,24,20">
            <TextBlock Text="New lead" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Fill in what you know. You need at least a name, practice or email; everything else can be added later."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,4" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tutor / contact name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FirstField" Grid.Row="1" Grid.Column="0" Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Practice" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Practice, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding EmailWarning}" Foreground="{StaticResource DueBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding EmailWarning, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Location / service area" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="6" Grid.Column="0" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="2" Text="Subjects / student levels" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Subjects, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Fit priority" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Row="8" Grid.Column="0" IsEditable="True" ItemsSource="{x:Static models:LeadOptions.Priorities}"
                          Text="{Binding FitPriority, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="7" Grid.Column="2" Text="Lead ID" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding LeadCode, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Suggested from your existing IDs; change it or leave it blank" />
            </Grid>
            <TextBlock Text="{Binding LeadCodeError}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right"
                       Visibility="{Binding LeadCodeError, Converter={StaticResource NullToVisibility}}" />

            <TextBlock Text="Website" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" MinHeight="70" />
        </StackPanel>
    </DockPanel>
</Window>
