<Application x:Class="LeadManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#5F6B7A" />
        <SolidColorBrush x:Key="PlaceholderText" Color="#9AA3AE" />
        <SolidColorBrush x:Key="Divider" Color="#D9DEE5" />
        <SolidColorBrush x:Key="PanelBackground" Color="#F6F7F9" />
        <SolidColorBrush x:Key="FollowUpDueRow" Color="#FFF1D6" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,0" />
        </Style>

        <Style x:Key="MultiLineBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="MaxHeight" Value="200" />
        </Style>
    </Application.Resources>
</Application>
