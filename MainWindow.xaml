<Window x:Class="LeadManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LeadManager.ViewModels"
        xmlns:views="clr-namespace:LeadManager.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Lead Manager" Height="600" Width="1000" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewLeadCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportCsvCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToDashboardCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoToLeadsCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Find" Executed="Find_Executed" />
    </Window.CommandBindings>

    <Grid>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Height="56" Padding="20,0,16,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewLeadCommand}" ToolTip="Add a lead by hand (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="New lead" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Command="{Binding ImportCsvCommand}"
                                ToolTip="Import leads from a CSV (Ctrl+O). Leads already here are matched by Lead ID or email, and your status, dates and notes are never overwritten.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,8,0" />
                                <TextBlock Text="Import CSV…" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="8,0,0,0" ToolTip="More" Click="MoreButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Email settings…" Command="{Binding OpenEmailSettingsCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE715;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Export all leads to CSV…" Command="{Binding ExportAllCommand}" />
                                    <MenuItem Header="Export the leads shown on the Leads page…" Command="{Binding ExportShownCommand}" />
                                    <Separator />
                                    <MenuItem Header="Show the database file" Command="{Binding ShowDatabaseFileCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Lead Manager" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,24,0" />
                        <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsDashboardPage}" ToolTip="Ctrl+1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontWeight="Normal" Margin="0,0,7,0" />
                                <TextBlock Text="Dashboard" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsLeadsPage}" ToolTip="Ctrl+2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontWeight="Normal" Margin="0,0,7,0" />
                                <TextBlock Text="Leads" />
                                <Border Background="{StaticResource HoverBrush}" CornerRadius="9" Padding="7,0,7,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LeadCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Both pages stay alive so the grid keeps its scroll position and sort -->
            <Grid>
                <Grid Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVisibility}}">
                    <views:DashboardView DataContext="{Binding Dashboard}" />
                </Grid>
                <Grid Visibility="{Binding IsLeadsPage, Converter={StaticResource BoolToVisibility}}">
                    <views:LeadListView x:Name="LeadListPage" DataContext="{Binding LeadList}" />
                </Grid>
            </Grid>
        </DockPanel>

        <!-- Messages ("Copied …", "Imported …"); errors stay until dismissed -->
        <Border DataContext="{Binding Notice}" Style="{StaticResource Toast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToastCloseButton}" Content="&#xE711;" Command="{Binding DismissCommand}"
                        Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Dismiss" />
                <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
